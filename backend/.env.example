# ==============================================================================
# SAATHI Backend Environment Configuration (Production & Development)
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Supabase PostgreSQL & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Orchestrator & LLM Providers
AI_PROVIDER=gemini # 'gemini' | 'openai' | 'fallback_rule_engine'
AI_API_KEY=your-gemini-or-openai-api-key
AI_MODEL_NAME=gemini-1.5-pro

# Voice / Audio Provider (AI4Bharat IndicConformer ASR & IndicF5 TTS)
VOICE_PROVIDER=ai4bharat # 'ai4bharat' | 'browser_native'
VOICE_PIPELINE_MODE=fallback # 'remote' (call GPU server) | 'local' | 'fallback' (development mock)
AI4BHARAT_ASR_URL=http://localhost:8001/asr # Endpoint hosting IndicConformer ASR
AI4BHARAT_TTS_URL=http://localhost:8002/tts # Endpoint hosting IndicF5 TTS
AI4BHARAT_API_KEY=your-ai4bharat-or-dhruva-key

# Hyper-Local Market & Scheme Providers
MARKET_DATA_PROVIDER=internal_radar # 'internal_radar' | 'census_india'
SCHEME_DATA_SOURCE=kvic_and_state_registry

# Security, Cache & Rate Limiting
RATE_LIMIT_STANDARD_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=20
IDEMPOTENCY_TTL_SECONDS=3600
ENCRYPTION_SECRET=your-32-byte-hex-encryption-secret
